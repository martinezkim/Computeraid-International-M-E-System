/**
 * Maps a legacy GAS ?page= key to the equivalent static path on the
 * Firebase-hosted frontend, optionally appending query params (e.g.
 * resetpassword's email/token, or login's reason=timeout). Single
 * source of truth for both Code.gs's doGet redirect and the
 * transactional email link-builders (EmailService.gs, AdminAuth.gs) —
 * keeps the URL scheme in exactly one place.
 */
function getFrontendUrl_(pageKey, params) {
  var path = (pageKey === 'resetpassword') ? '/resetpassword.html'
    : (pageKey === 'login' || pageKey === 'adminlogin' || pageKey === 'managerlogin') ? '/login.html'
    : '/index.html';

  var qs = Object.keys(params || {})
    .filter(function (k) { return params[k]; })
    .map(function (k) { return k + '=' + encodeURIComponent(params[k]); })
    .join('&');

  return APP_CONFIG.FIREBASE_APP_URL + path + (qs ? '?' + qs : '');
}

/**
 * SCHEMA defines every "table" (worksheet) in the system.
 *
 * `autoId` defaults to true, meaning the primary key is generated by
 * DB.generateId() using `idPrefix`/`idPadding` (C001, H001, ...). Set
 * `autoId: false` for tables with a natural key supplied by the caller
 * (e.g. HubManagers is keyed by Email) — DB.insert() will then use the
 * caller-provided value and enforce uniqueness itself.
 */
var SCHEMA = {

  Countries: {
    sheetName: 'Countries',
    primaryKey: 'CountryID',
    idPrefix: 'C',
    idPadding: 3,
    columns: ['CountryID', 'CountryName', 'ISOCode', 'Status', 'DateCreated', 'DateModified'],
    searchableColumns: ['CountryName', 'ISOCode'],
    foreignKeys: {}
  },

  Hubs: {
    sheetName: 'Hubs',
    primaryKey: 'HubID',
    idPrefix: 'H',
    idPadding: 3,
    columns: [
      'HubID', 'HubName', 'CountryID', 'CountyOrState', 'Town', 'Address', 'DateCreated', 'DateModified', 'Status',
      // Appended for per-hub optional tabs (Module: optional tabs). Comma-
      // separated page keys from MANAGER_OPTIONAL_PAGES (Router.gs) this
      // hub's Manager may see — everything else in that list stays
      // greyed out for them until an Admin ticks it here. The compulsory
      // pages (Dashboard/My Projects/Beneficiaries/Hub Usage/My Devices)
      // are never affected by this — see getHubEnabledTabs_ in Hubs.gs.
      'EnabledOptionalTabs'
    ],
    searchableColumns: ['HubName', 'CountyOrState', 'Town'],
    foreignKeys: {
      CountryID: { table: 'Countries', column: 'CountryID' }
    }
  },

  /**
   * HubManagers is keyed by Email (a manager's login identity), not an
   * auto-generated ID — that's what the person actually authenticates
   * with. DB.insert() enforces that no two records can share an Email.
   * Password fields are never sent to the client; see
   * stripSensitiveManagerFields() in Managers.gs.
   */
  HubManagers: {
    sheetName: 'HubManagers',
    primaryKey: 'Email',
    autoId: false,
    columns: [
      'Email', 'FirstName', 'LastName', 'Phone', 'HubID',
      'PasswordHash', 'PasswordSalt', 'MustResetPassword',
      'ResetToken', 'ResetTokenExpiry',
      'Status', 'DateCreated', 'DateModified',
      // Self-service profile fields (ManagerProfile.gs). BankAccountNumber/
      // MobileMoneyNumber are stored in full but a Hub Manager only ever
      // sees their own masked back (getMyManagerProfile) — same
      // maskAccountNumber_ convention FinancialAccounts already uses —
      // Admin/Finance see them in full since they're the ones who'd
      // actually action a payout.
      'Address', 'PhotoUrl',
      'BankName', 'BankAccountName', 'BankAccountNumber',
      'MobileMoneyProvider', 'MobileMoneyName', 'MobileMoneyNumber',
      // Appended for the generated-invoice Terms footer (Module: invoice
      // generation) — the rest of the bank block a payout instruction
      // needs beyond name/account-number. Not sensitive the way the
      // account number is, so these aren't masked.
      'BankCode', 'SwiftCode', 'BankBranch', 'BranchCode'
    ],
    searchableColumns: ['FirstName', 'LastName', 'Email', 'Phone'],
    foreignKeys: {
      HubID: { table: 'Hubs', column: 'HubID' }
    }
  },

  /**
   * Admins are the system administrators — now a real credential-based
   * login (email + password), replacing the earlier "anyone who opens
   * the URL is trusted as admin via their Google session" assumption.
   * The very first account is created by running createInitialAdmin()
   * once from the Apps Script editor — see AdminAuth.gs. Every other
   * admin account (any AccessLevel) is created from the in-app
   * Administrators page (AdminTeam.gs), SuperAdmin-only.
   */
  Admins: {
    sheetName: 'Admins',
    primaryKey: 'Email',
    autoId: false,
    columns: [
      'Email', 'FirstName', 'LastName', 'PasswordHash', 'PasswordSalt', 'Status', 'DateCreated', 'DateModified', 'ResetToken', 'ResetTokenExpiry',
      // Appended for Module 3 (roles): SuperAdmin sees/does everything
      // and manages other admin accounts; CountryDirector is exactly
      // today's original, unrestricted Admin; MELead/Accountant are each
      // scoped to a narrower page set — see ACCESS_LEVEL_RESTRICTED_PAGES
      // in Router.gs (the real enforcement) and resolveAdminAccessLevel_
      // in AdminAuth.gs (self-heals a blank value on next login rather
      // than needing a manual backfill).
      'AccessLevel',
      // Appended for per-country data scoping: which Country a
      // CountryDirector is restricted to. Blank is a PERMANENT, valid
      // state meaning "unscoped — sees every country," not just a
      // pre-migration default — every account that predates this field
      // keeps working exactly as before until an Admin deliberately
      // assigns one. Only ever consulted for AccessLevel==='CountryDirector';
      // meaningless (never read) for SuperAdmin/MELead/Accountant. See
      // resolveAdminHubScope_ in CountryScope.gs — the real enforcement.
      'CountryID'
    ],
    searchableColumns: ['FirstName', 'LastName', 'Email'],
    foreignKeys: {
      CountryID: { table: 'Countries', column: 'CountryID' }
    }
  },

  /**
   * Lightweight login sessions shared by every credentialed role (Admins
