   * sendChatMessage/getThreadMessages. Deliberately named SentAt, not
   * DateCreated: DB.insert() force-overwrites any column literally named
   * DateCreated/DateModified with a raw Date object regardless of what's
   * passed in, and _rowToObject() then truncates a Date-typed cell to a
   * bare 'yyyy-MM-dd' on read (see Database.gs's own header comment on
   * this) — fine for ordinary record-creation bookkeeping, but it would
   * silently drop every message's time-of-day, breaking same-day
   * ordering and display for what's supposed to be a chat. Stored as an
   * ISO string instead, same convention as Sessions.ExpiresAt.
   */
  ChatMessages: {
    sheetName: 'ChatMessages',
    primaryKey: 'MessageID',
    idPrefix: 'MSG',
    idPadding: 6,
    columns: ['MessageID', 'ThreadID', 'SenderEmail', 'Body', 'SentAt'],
    searchableColumns: ['Body'],
    foreignKeys: {
      ThreadID: { table: 'ChatThreads', column: 'ThreadID' }
    }
  }

  // Future modules plug in here following the same shape:
  // Indicators, Donors, Trainings, MonitoringVisits, Reports,
  // Evidence, Roles, Permissions ...
};
